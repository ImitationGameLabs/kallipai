# https, app, api and the model gateway served from the bundle in this image:
# production, and any deployment that terminates TLS with a certificate pair the
# host renews.
import site.caddy

{$KALLIPAI_EDGE_SITE} {
	tls {$KALLIPAI_TLS_CERT} {$KALLIPAI_TLS_KEY}
	import app-bundle
}

{$KALLIPAI_API_BASE} {
	tls {$KALLIPAI_TLS_CERT} {$KALLIPAI_TLS_KEY}
	import kallipai-api-routes
}

{$KALLIPAI_MODEL_GW_SITE} {
	tls {$KALLIPAI_TLS_CERT} {$KALLIPAI_TLS_KEY}
	import model-gw-routes
}
