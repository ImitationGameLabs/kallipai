# The service environment file for a production compose deployment: the file
# KALLIPAI_ENV_FILE names. scripts/compose-up.sh's own variables (the domain,
# the TLS directory, the image tag) live in compose/.env beside the compose
# files instead; print that one with scripts/compose-env.sh --example prod.
#
# Keys this file cannot set: compose.yaml pins the addresses, the internal
# token path and the archeion hop inside service.environment, and those win
# over env_file. A key that is unset here falls back to the binary's own
# default, noted where one exists.
# A commented-out key is unset; a key set to nothing is an empty value, and
# whether that means unset depends on the reader: archeion trims an empty
# OAuth id or secret to unset, and takes an empty admin token as the token.
#
# Values below are placeholders. Every one is a deployment decision. The
# browser-facing ones are not here: compose.prod.yaml derives the CORS origins,
# the session cookie domain, the WebAuthn relying party and the OAuth return
# base from KALLIPAI_DOMAIN, so they follow the app the edge serves.

# --- archeion: identity control plane -----------------------------------------

# Postgres URL of the control-plane store (required: no default). The schema
# is migrated at boot.
KALLIPAI_ARCHEION_DATABASE_URL=postgres://kallipai:change-me@archeion-postgres:5432/kallipai

# Mark the session cookie Secure (default true; only a plain-HTTP deployment
# turns it off).
KALLIPAI_ARCHEION_COOKIE_SECURE=true

# The name a passkey dialog shows. The relying party id and origin come from
# the domain, and the id cannot change once passkeys are bound to it.
KALLIPAI_ARCHEION_WEBAUTHN_RP_NAME=KallipAI

# CIDRs trusted to set X-Forwarded-For. The edge runs as a container on the
# platform network, so the default (loopback only) is wrong here: name the
# network's subnet.
KALLIPAI_ARCHEION_TRUSTED_PROXIES=172.16.0.0/12

# Provisioning token: uncomment one of the two lines below. Either a token
# here (32 characters or more; that floor applies only when admin login is
# on), or a file to mint one into on first boot. archeion refuses to start
# with neither. A token line left empty counts as set and boots with a blank
# token, so leave it commented out. The file must land on a writable path:
# polis_internal is the volume every service reads.
#KALLIPAI_ARCHEION_ADMIN_TOKEN=
#KALLIPAI_ARCHEION_ADMIN_TOKEN_OUT_FILE=

# Open signup (default true). False closes new accounts and leaves existing
# logins working.
KALLIPAI_ARCHEION_SIGNUP_ENABLED=true

# OAuth: a provider is enabled only when both its id and secret are set. The
# return base follows the domain, so register https://app.<domain>/auth/callback
# with the provider.
#KALLIPAI_ARCHEION_OAUTH_GITHUB_CLIENT_ID=
#KALLIPAI_ARCHEION_OAUTH_GITHUB_CLIENT_SECRET=
#KALLIPAI_ARCHEION_OAUTH_GOOGLE_CLIENT_ID=
#KALLIPAI_ARCHEION_OAUTH_GOOGLE_CLIENT_SECRET=

# --- lesche: relay data plane -------------------------------------------------

# Postgres URL of the chat store (required: no default).
KALLIPAI_LESCHE_DATABASE_URL=postgres://kallipai:change-me@lesche-postgres:5432/kallipai

# --- keryx: tagma link relay --------------------------------------------------

# Bearer for the keryx /internal surface the files service pushes delivery
# events through. Empty leaves that surface unmounted; when set it must equal
# KALLIPAI_FILES_NOTIFY_TOKEN below.
KALLIPAI_KERYX_INTERNAL_TOKEN=

# --- files: content transfer --------------------------------------------------

# Postgres URL of the record metadata store (required: no default). Blobs live
# in the kallipai_files_blobs volume, not here.
KALLIPAI_FILES_DATABASE_URL=postgres://kallipai:change-me@files-postgres:5432/kallipai
# Where delivered-file events are pushed; empty disables the push.
KALLIPAI_FILES_NOTIFY_URL=http://keryx:7210
KALLIPAI_FILES_NOTIFY_TOKEN=

# --- instances: instance list -------------------------------------------------

# Host header values the guard accepts besides the bind address: the public
# name the edge forwards, plus `instances`. The second one is how the status
# probe reaches the service from inside the platform network, where that name
# is the only one it answers to; nothing outside that network resolves it.
KALLIPAI_INSTANCES_ALLOWED_HOSTS=api.example.com,instances

# --- model-gateway: LLM gateway -----------------------------------------------

# Postgres URL of the gateway store (required: no default).
KALLIPAI_MODEL_GATEWAY_DATABASE_URL=postgres://kallipai:change-me@gateway-postgres:5432/kallipai
# Origin the gateway advertises to model clients, path included.
KALLIPAI_MODEL_GATEWAY_PUBLIC_BASE_URL=https://api.example.com/v1/model-gateway

# --- postgres stores ----------------------------------------------------------
#
# One set of credentials for all four stores: each store runs in its own volume
# and each service reaches it through its own DATABASE_URL above. The values are
# read when a volume is first initialised, so changing them afterwards does not
# reach an existing store.
POSTGRES_USER=kallipai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kallipai
