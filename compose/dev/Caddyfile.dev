# Dev edge proxy (see arion-compose.nix services.caddy). Terminates TLS with
# the mkcert leaf cert mounted at /certs and host-routes the three subdomains to
# the dev services on 127.0.0.1 (caddy runs on the host network). The explicit
# `tls` directive disables Caddy's internal CA / ACME: the dev domain is a
# non-public TLD, so automatic issuance cannot succeed and is not wanted.
#
# The domain comes from {$KALLIP_DEV_DOMAIN} (Caddy's native env substitution),
# set on the caddy service by arion-compose.nix from the same var the agora/
# lesche env and the web app use (code default kallipai.com; .env sets
# kallipai.lan for dev). See docs/development.md for the one-time host setup
# (mkcert cert into <repo>/dev-certs, host trust, LAN DNS).
#
# Global options: HTTP/3 is disabled in dev. Caddy advertises `alt-svc: h3`
# otherwise, and Firefox upgrades the cross-subdomain SSE (`/v1/me/events`) to
# h3, where the long-lived stream wedges (curl h3 works; Firefox's h3 stack
# does not). Pinning h1/h2 keeps the app SSE flowing without changing the
# prod topology decision. Re-enable here once the h3 streaming path is verified
# end-to-end in Firefox.
{
	servers {
		protocols h1 h2
	}
}

*.{$KALLIP_DEV_DOMAIN} {
	tls /certs/cert.pem /certs/key.pem

	@web host web.{$KALLIP_DEV_DOMAIN}
	handle @web {
		# vite dev server on the host
		reverse_proxy 127.0.0.1:5173
	}

	@agora host agora.{$KALLIP_DEV_DOMAIN}
	handle @agora {
		# agora is published on the host at :7100
		reverse_proxy 127.0.0.1:7100
	}

	@lesche host lesche.{$KALLIP_DEV_DOMAIN}
	handle @lesche {
		# lesche is published on the host at :7200
		reverse_proxy 127.0.0.1:7200 {
			# SSE is auto-detected (Content-Type: text/event-stream) and flushed
			# immediately regardless; this is a safety net for any future
			# non-SSE streaming endpoint so responses are never buffered.
			flush_interval -1
		}
	}

	# Any other *.<devDomain> host (typo, or the bare apex) matched the wildcard
	# site block's SNI but no route above -- surface it as a real 404 rather than
	# Caddy's default empty 200, so misroutes are obvious.
	handle {
		respond 404
	}
}
