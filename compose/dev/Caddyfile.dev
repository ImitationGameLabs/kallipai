# Dev edge proxy (see arion-compose.nix services.caddy). The one entry
# point for the dev stack: host-routes the app.{$KALLIP_DOMAIN} (web app) and
# api.{$KALLIP_DOMAIN} (platform, path-routed /v1/<service>) vhosts to the dev
# services on 127.0.0.1 (caddy runs on the host network). A loopback
# plaintext edge (http://127.0.0.1:7443) mirrors the api route table for the
# dev tagma, whose webpki-roots reqwest cannot trust the mkcert edge.
# The same vhosts serve both edge shapes: https (default) terminates TLS with
# the mkcert leaf cert mounted at /certs; KALLIP_EDGE_TLS=off serves the
# identical routes plain http -- the {$KALLIP_EDGE_SCHEME} prefix on the
# site address (set to http://) keeps Caddy's auto-https out of a
# non-public TLD, and the mounted tls.caddy snippet beside this file
# `tls` directive only for the https shape. The explicit `tls` directive
# otherwise disables Caddy's internal CA / ACME: the dev domain is a
# non-public TLD, so automatic issuance cannot succeed and is not wanted.
#
# The substitutions come from the caddy service environment, sourced from
# the same nix bindings the archeion/lesche env use (code default
# kallipai.com; .env sets kallipai.lan for dev). See docs/en/development/setup.md
# for the one-time host setup (mkcert cert into <repo>/compose/dev/.certs,
# host trust, LAN DNS).
#
# Global options: HTTP/3 is disabled in dev. Caddy advertises `alt-svc: h3`
# otherwise, and Firefox upgrades the cross-subdomain SSE (`/v1/lesche/me/events`) to
# h3, where the long-lived stream wedges (curl h3 works; Firefox's h3 stack
# does not). Pinning h1/h2 keeps the app SSE flowing without changing the
# prod topology decision. Re-enable here once the h3 streaming path is verified
# end-to-end in Firefox.
{
  servers {
    protocols h1 h2
  }
}

{$KALLIP_EDGE_SCHEME}*.{$KALLIP_DOMAIN}:{$KALLIP_EDGE_PORT} {
  import tls.caddy

  @app host app.{$KALLIP_DOMAIN}
  handle @app {
    # the host vite dev server (packages/kallip-web `deno task dev`,
    # appHost in its vite.config) serves the SPA with HMR.
    reverse_proxy 127.0.0.1:5173
  }

  @api host api.{$KALLIP_DOMAIN}
  handle @api {
    # The platform's single API face, path-routed by service segment.
    # handle_path strips /v1/<service> and forwards the remainder as-is:
    # all four backends serve bare resource paths, so the strip is the
    # whole story - no rewrites, and no identity-mapping exception for files
    # (its named matcher below covers the bare /v1/files prefix too).
    import kallip-api-routes
  }

  # Any other *.<devDomain> host (typo, or the bare apex) matched the wildcard
  # site block's SNI but no route above -- surface it as a real 404 rather
  # than Caddy's default empty 200, so misroutes are obvious.
  handle {
    respond 404
  }
}

# The api.<domain> route table, shared by the https wildcard edge above and
# the loopback plaintext edge below (one place to review the path map):
# /v1/<service>/* -> the stripped remainder, forwarded as-is.
(kallip-api-routes) {
  handle_path /v1/archeion/* {
    reverse_proxy 127.0.0.1:7100
  }
  handle_path /v1/lesche/* {
    reverse_proxy 127.0.0.1:7200 {
      # SSE is auto-detected (Content-Type: text/event-stream) and flushed
      # immediately regardless; this is a safety net for any future
      # non-SSE streaming endpoint so responses are never buffered.
      flush_interval -1
    }
  }
  @files path /v1/files /v1/files/*
  handle @files {
    uri strip_prefix /v1/files
    reverse_proxy 127.0.0.1:7400
  }
  handle_path /v1/instances/* {
    reverse_proxy 127.0.0.1:7300
  }
  # Unregistered /v1/* prefixes on the api face are a real 404.
  respond 404
}

# Loopback plaintext edge for the dev tagma (host network): the tagma's
# reqwest uses webpki-roots, so the mkcert https edge is untrusted from
# inside the container; the tagma rides the same route table over plain
# HTTP on loopback instead (KALLIP_POLIS_URL points here). Dev-only --
# prod tagmas reach the public https api.<domain> face directly.
http://127.0.0.1:7443 {
  import kallip-api-routes
}
