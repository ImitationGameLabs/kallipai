{
  "name": "@kallipai/kallip-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pagefind --site build",
    "preview": "vite preview",
    "prepare": "(svelte-kit sync || echo '')",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf node_modules/.vite .svelte-kit build",
    "test": "deno test --allow-read"
  },
  "dependencies": {
    "@comark/svelte": "^0.7.0",
    "@lucide/svelte": "^1.24.0",
    "comark": "^0.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^5.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "pagefind": "^1.5.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
