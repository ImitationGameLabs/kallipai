# The tagma's own settings: the daemon and the agent shells read these, and
# direnv loads this file into the shell for `deno task dev`. Copy it to `.env`
# in this directory.
#
# The compose stack's settings live in `compose/.env.example`: the platform
# services read theirs from `compose/.env`, and none of them is in this file.
#
# Model configuration lives in profiles.toml (<config home>/kallipai/tagmata/<slug>)
# or on the tagma's Profiles page: provider, model and API keys are entries in
# the file. See docs/en/configuration/tagma/methods.md.

# Agent Core (all optional, defaults shown)

# System prompt injected into every LLM session.
# Default: built-in posture + tool/round-model prompt (see DEFAULT_SYSTEM_PROMPT
# in config.rs). A per-agent identity section is always tagma-injected at the
# head of the base prompt.
#KALLIPAI_SYSTEM_PROMPT=

# Maximum tool-call rounds per agent session. Must be > 0.
# Default: unlimited (bounded by tagma-wide token budget).
# Set this to enforce a hard round limit independent of token consumption.
#KALLIPAI_MAX_TOOL_ROUNDS=

# Max consecutive heartbeat rounds (bare-assistant re-loops) before the harness
# force-idles the agent. Default: 3.
#KALLIPAI_MAX_HEARTBEAT_ROUNDS=3

# Max consecutive transient (failover-chain-exhausted) parks that earn a timed
# retry before the agent hard-parks. Default: 3.
#KALLIPAI_MAX_TRANSIENT_RETRIES=3

# Root directory for agent workspace. Falls back to current working directory.
# Can also be set via CLI --workspace-root.
#KALLIPAI_WORKSPACE_ROOT=

# Tokens reserved for model output within the context window.
# Must be less than the active context window (128000 unless a profile sets one).
# Default: 8192
#KALLIPAI_OUTPUT_RESERVE_TOKENS=8192

# Maximum tokens for compacted (summarized) context. Must be > 0 and fit
# within the pinned budget (effective_budget × pinned_budget_ratio).
# Default: 1200
#KALLIPAI_SUMMARY_MAX_TOKENS=1200

# Timeout in seconds for individual tool executions.
# Default: 120
#KALLIPAI_TOOL_TIMEOUT_SECS=120

# Fraction of effective budget allocated to pinned context items.
# Must be between 0.0 and 1.0 (exclusive).
# Default: 0.25
#KALLIPAI_PINNED_BUDGET_RATIO=0.25

# Context usage thresholds (comma-separated percentages, 1-99, sorted ascending, ≥ 2 values).
# The last value triggers auto-compact; preceding values are warnings.
# Default: 50,60,70,80
#KALLIPAI_CONTEXT_THRESHOLDS=50,60,70,80

# Conversation turns a manual context eviction keeps. 0 evicts every turn.
# Default: 20
#KALLIPAI_CONTEXT_KEEP_TURNS=20

# Share of the effective budget those turns may spend. Must be > 0.0 and <= 1.0.
# Default: 0.15
#KALLIPAI_CONTEXT_KEEP_TOKENS_RATIO=0.15

# Maximum retries for LLM API calls. Must be <= 1000: a sanity cap on the knob (the attempt arithmetic saturates, so nothing wraps).
# Default: 10
#KALLIPAI_MAX_RETRIES=10

# Base delay in seconds for exponential retry backoff. Must be > 0 and <= 3600.
# Default: 1
#KALLIPAI_RETRY_BASE_DELAY_SECS=1
# Cap in seconds for a single retry backoff. Must be > 0 and <= 3600.
# Default: 60
#KALLIPAI_RETRY_MAX_DELAY_SECS=60

# Deadline in seconds for one retry episode (its time on trial, measured from its first attempt). Must be > 0 and <= 86400 (avoids Instant overflow).
# Default: 300
#KALLIPAI_RETRY_TIMEOUT_SECS=300

# Tagma-global bash_exec classify preset, read once at startup.
#   default   — catalog commands allow, unclassified ask, denylist/structural deny.
#   auto      — like default, but unclassified commands allow too (denylist still applies).
#   allow-all — debug: every parseable command allows (denylist bypassed).
# Default: default
#KALLIPAI_POLICY_PRESET=default

# Token budget usage warning thresholds (comma-separated percentages, 1-99,
# sorted ascending, ≥ 1 value). The agent receives a warning message when
# cumulative token consumption crosses each threshold.
# Default: 80,95
#KALLIPAI_TOKEN_BUDGET_WARNINGS=80,95

# Tagma

# Listen address for the tagma HTTP server.
# Default: 127.0.0.1:3000
#KALLIPAI_TAGMA_ADDR=127.0.0.1:3000

# URL that agents use to reach this tagma (injected into shell sessions).
# Default: http://127.0.0.1:3000
#KALLIPAI_ADVERTISE_URL=http://127.0.0.1:3000

# Max queued messages per agent (message channel capacity). When full, send_message returns 503.
# Default: 5
#KALLIPAI_PROMPT_QUEUE_SIZE=5

# Max concurrent agent instances. Creation returns 503 when at capacity. Restore is exempt.
# Range: 1..=1000
# Default: 50
#KALLIPAI_MAX_AGENTS=50

# Max direct subagents per agent. Creation returns 503 when the supervisor is at capacity.
# Range: 1..=100
# Default: 20
#KALLIPAI_MAX_SUBAGENTS=20

# Max HTTP request body size in kilobytes. 0 = axum default (2 MB).
# Oversized requests return 413.
# Default: 1024
#KALLIPAI_MAX_BODY_SIZE_KB=1024

# Pre-set the tagma operator token. When unset, a random UUID is generated at startup.
# Set this for automation (e.g., CI/CD, Harbor integration) where the token must be known in advance.
# Default: (unset — random UUID printed to stdout)
#KALLIPAI_OPERATOR_TOKEN=

# User-Agent header sent on outbound LLM chat completion requests.
# Override verbatim (leading/trailing whitespace preserved); illegal header chars fail fast at startup.
# Default: kallipai/<tagma-version>
#KALLIPAI_LLM_API_USER_AGENT=

# The per-agent auth token the tagma injects into each agent's shell (so `kallip
# lesche send` and other self-scoped subcommands authenticate as that agent).
# For the operator-facing CLI, set this to KALLIPAI_OPERATOR_TOKEN. The
# kallipai-cron daemon also reuses this for delivery (it must hold the tagma's
# operator secret so fired schedules inject as `[From: operator]`); the
# `kallipai-cron` CLI reads it as the agent bearer for management requests.
#KALLIPAI_AUTH_TOKEN=

# Relay enrollment: a single-use sk-enroll-... minted via the archeion dashboard
# (after a user signs up). Set ONLY on the tagma's first boot (when
# KALLIPAI_POLIS_URL is set), then remove it -- the tagma token is
# then persisted under the instance data root's credentials/.
#KALLIPAI_TAGMA_RELAY_ENROLLMENT_CODE=

# KALLIPAI_TAGMA_URL is set at runtime by the tagma for agent shells; do not add
# it here. See docs/en/reference/environment-variables/ for details.

# Logging

# Standard tracing filter. Controls log verbosity of every process this file
# reaches; each compose service carries its own in the compose files.
# Default: info
#RUST_LOG=info

# Data and Skills

# The instance is named by KALLIPAI_TAGMA_SLUG; its data root is derived from it
# under the platform data dir (set KALLIPAI_TAGMA_SLUG when running the tagma
# directly; a service unit sets it).

# Direct path to the shared skill directory (used as-is, no suffix appended).
# Checked before DATA_DIR and platform default.
# Default: (unset — uses the resolved data dir's skills/ subtree)
#KALLIPAI_SKILLS_ROOT=

# Local telemetry budgets, read by `kallipai-telemetry-prune` (its defaults
# are 5 GiB and 72h). For a one-off investigation only: they move the pruner,
# not the retention the stack configures.
#KALLIPAI_TELEMETRY_MAX_BYTES=5368709120
#KALLIPAI_TELEMETRY_MAX_AGE_HOURS=72

# The bearer token every OTLP push carries. The collector mounts this file
# read-only at /etc/kallipai/intake-token and reads it at boot; the compose
# files refuse to start without the path. One line, 0600, the same token the
# pushing services carry.
#KALLIPAI_TELEMETRY_INTAKE_TOKEN_FILE=/etc/kallipai/intake-token

# --- prod-tagma only
# Multiple platform edges (multi-relay) tagmas: <data-root>/polis.toml ([[polis]]
# name / url / enrollment_code; see docs/en/development/setup.md) declares several
# edges at once; the KALLIPAI_POLIS_URL var below is the single-edge sugar (one
# implicit entry named "default"). The file and the var are mutually exclusive
# (fail-fast).

# The platform's public API origin: the single base from which the tagma
# derives every platform endpoint -- enrollment at the archeion, the lesche
# tunnel, envelopes, key-exchange responses, and media fetches (e.g.
# https://api.kallipai.com). Setting it (any non-empty value) activates the
# relay; if enrollment fails the tagma degrades to local-only (logs an error,
# keeps serving local agents; the lesche message route returns 503).
#KALLIPAI_POLIS_URL=


# Max `kallip lesche send` deliveries per burst window (bounds a runaway agent
# message loop; process-global — today one root agent = one conversation).
# Default: 20.
#KALLIPAI_TAGMA_RELAY_MESSAGE_BURST_MAX=20

# Length in seconds of the message burst window. Default: 10.
#KALLIPAI_TAGMA_RELAY_MESSAGE_BURST_WINDOW_SECS=10

# Web app build

# Show the operator-key login branch on the app's sign-in page. Read at build
# time from the build environment and folded into the bundle, so it decides how
# the shipped build looks, not how a running server behaves. Set it for a
# local-platform build; a cloud build never renders the branch.
#KALLIPAI_OFFLINE_LOGIN=1
