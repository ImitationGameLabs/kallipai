# LLM Provider (required)

# The LLM backend to use. Supported values: "deepseek", "openai-compatible".
KALLIP_LLM_PROVIDER=deepseek

# Model identifier passed to the provider (e.g. "deepseek-v4-flash", "glm-5.1").
KALLIP_LLM_MODEL=deepseek-v4-flash

# LLM Credentials

# Required when KALLIP_LLM_PROVIDER=deepseek.
KALLIP_LLM_DEEPSEEK_API_KEY=
# Optional: override the default DeepSeek API endpoint.
#KALLIP_LLM_DEEPSEEK_BASE_URL=

# Required when KALLIP_LLM_PROVIDER=openai-compatible.
KALLIP_LLM_OPENAI_COMPAT_API_KEY=
# Optional: override the default OpenAI-compatible API endpoint.
#KALLIP_LLM_OPENAI_COMPAT_BASE_URL=

# Agent Core (all optional, defaults shown)

# System prompt injected into every LLM session.
# Default: built-in posture + tool/round-model prompt (see DEFAULT_SYSTEM_PROMPT
# in config.rs). A per-agent identity section is always tagma-injected at the
# head of the base prompt.
#KALLIP_SYSTEM_PROMPT=

# Maximum tool-call rounds per agent session. Must be > 0.
# Default: unlimited (bounded by tagma-wide token budget).
# Set this to enforce a hard round limit independent of token consumption.
#KALLIP_MAX_TOOL_ROUNDS=

# Max consecutive heartbeat rounds (bare-assistant re-loops) before the harness
# force-idles the agent. Default: 3.
#KALLIP_MAX_HEARTBEAT_ROUNDS=3

# Max consecutive transient (failover-chain-exhausted) parks that earn a timed
# retry before the agent hard-parks. Default: 3.
#KALLIP_MAX_TRANSIENT_RETRIES=3

# Root directory for agent workspace. Falls back to current working directory.
# Can also be set via CLI --workspace-root.
#KALLIP_WORKSPACE_ROOT=

# Context window size in tokens. Must be > 0.
# Default: 128000
#KALLIP_CONTEXT_WINDOW_TOKENS=128000

# Tokens reserved for model output within the context window.
# Must be less than CONTEXT_WINDOW_TOKENS.
# Default: 8192
#KALLIP_OUTPUT_RESERVE_TOKENS=8192

# Maximum tokens for compacted (summarized) context. Must be > 0 and fit
# within the pinned budget (effective_budget × pinned_budget_ratio).
# Default: 1200
#KALLIP_SUMMARY_MAX_TOKENS=1200

# Timeout in seconds for individual tool executions.
# Default: 120
#KALLIP_TOOL_TIMEOUT_SECS=120

# Fraction of effective budget allocated to pinned context items.
# Must be between 0.0 and 1.0 (exclusive).
# Default: 0.25
#KALLIP_PINNED_BUDGET_RATIO=0.25

# Context usage thresholds (comma-separated percentages, 1-99, sorted ascending, ≥ 2 values).
# The last value triggers auto-compact; preceding values are warnings.
# Default: 50,60,70,80
#KALLIP_CONTEXT_THRESHOLDS=50,60,70,80

# Maximum retries for LLM API calls. Must be <= 1000 (u32::MAX would wrap the attempt budget to zero).
# Default: 10
#KALLIP_MAX_RETRIES=10

# Base delay in seconds for exponential retry backoff. Must be > 0 and <= 3600.
# Default: 1
#KALLIP_RETRY_BASE_DELAY_SECS=1
# Cap in seconds for a single retry backoff (Retry-After can still exceed it only up to the timeout window). Must be > 0 and <= 3600.
# Default: 60
#KALLIP_RETRY_MAX_DELAY_SECS=60

# Overall deadline in seconds for one stream_with_retry call's retry sequence. Must be > 0 and <= 86400 (avoids Instant overflow).
# Default: 300
#KALLIP_RETRY_TIMEOUT_SECS=300

# Tagma-global bash_exec classify preset, read once at startup.
#   default   — catalog commands allow, unclassified ask, denylist/structural deny.
#   auto      — like default, but unclassified commands allow too (denylist still applies).
#   allow-all — debug: every parseable command allows (denylist bypassed).
# Default: default
#KALLIP_POLICY_PRESET=default

# Token budget usage warning thresholds (comma-separated percentages, 1-99,
# sorted ascending, ≥ 1 value). The agent receives a warning message when
# cumulative token consumption crosses each threshold.
# Default: 80,95
#KALLIP_TOKEN_BUDGET_WARNINGS=80,95

# Tagma

# Listen address for the tagma HTTP server.
# Default: 127.0.0.1:3000
#KALLIP_TAGMA_ADDR=127.0.0.1:3000

# URL that agents use to reach this tagma (injected into shell sessions).
# Default: http://127.0.0.1:3000
#KALLIP_ADVERTISE_URL=http://127.0.0.1:3000

# Max queued messages per agent (message channel capacity). When full, send_message returns 503.
# Default: 5
#KALLIP_PROMPT_QUEUE_SIZE=5

# Max concurrent agent instances. Creation returns 503 when at capacity. Restore is exempt.
# Range: 1..=1000
# Default: 50
#KALLIP_MAX_AGENTS=50

# Max direct subagents per agent. Creation returns 503 when the supervisor is at capacity.
# Range: 1..=100
# Default: 20
#KALLIP_MAX_SUBAGENTS=20

# Max HTTP request body size in kilobytes. 0 = axum default (2 MB).
# Oversized requests return 413.
# Default: 1024
#KALLIP_MAX_BODY_SIZE_KB=1024

# Pre-set the tagma operator token. When unset, a random UUID is generated at startup.
# Set this for automation (e.g., CI/CD, Harbor integration) where the token must be known in advance.
# Default: (unset — random UUID printed to stdout)
#KALLIP_OPERATOR_TOKEN=

# User-Agent header sent on outbound LLM chat completion requests.
# Override verbatim (leading/trailing whitespace preserved); illegal header chars fail fast at startup.
# Default: kallip/<tagma-version>
#KALLIP_LLM_API_USER_AGENT=

# Note: KALLIP_AUTH_TOKEN and KALLIP_TAGMA_URL are set at runtime by the
# tagma — do not add them here. See docs/reference/env.md for details.

# Data and Skills

# The instance is named by KALLIP_TAGMA_SLUG; its data root is derived from it
# under the platform data dir (set KALLIP_TAGMA_SLUG when running the tagma
# directly; compose sets it).

# Direct path to the shared skill directory (used as-is, no suffix appended).
# Checked before DATA_DIR and platform default.
# Default: (unset — uses the resolved data dir's skills/ subtree)
#KALLIP_SKILLS_ROOT=

# Logging

# Standard tracing filter. Controls log verbosity.
# Default: info
#RUST_LOG=info

# Archeion / Relay (arion dev + prod stack)
# Secrets below — populate .env (gitignored), never commit. See
# docs/reference/container.md for the per-mode contract.

# Dev domain for the Caddy-fronted arion topology (web/archeion/lesche subdomains).
# The code default is the prod domain (kallipai.com); local dev overrides it to a
# dev-only name so dev DNS/certs never clash with production. direnv's `dotenv`
# loads .env into the shell, so arion eval, mkcert, and vite all see
# it. Prod ignores it (prod-archeion uses real domains via the vars below).
# Renamed from KALLIP_DEV_DOMAIN (2026-08-27): a local .env carrying the old
# name should rename the line to KALLIP_DOMAIN (value unchanged).
KALLIP_DOMAIN=kallipai.lan

# The dev edge (compose caddy): KALLIP_EDGE_TLS=on (default) serves the
# subdomain vhosts over https with the mkcert cert; off serves the same
# routes plain http (no cert/DNS trust setup). KALLIP_EDGE_PORT moves
# the listen port (default 443) so a deployed system caddy keeps the
# host's real 443; the browser-facing web origin carries the port
# when it is not the protocol default, and CORS/oauth derive
# from it verbatim.
#KALLIP_EDGE_TLS=off
#KALLIP_EDGE_PORT=8443

# Show the operator-key login branch in the web app (local-platform dev).
# direnv loads this into the shell, so both `deno task dev` and local web
# builds carry the offline branch; a cloud build never reads this .env.
#VITE_OFFLINE_LOGIN=1

# Parallel dev stack (archeion compose only): override the project name and
# the HOST side of the published ports to bring up a second, independent
# stack for the dual-archeion acceptance flow (see compose/dev/polis.nix for
# the full bring-up line). Unset -> the single default stack.
#KALLIP_ARION_PROJECT_NAME=kallipai-dev2
#KALLIP_ARION_ARCHEION_PORT=7101
#KALLIP_ARION_LESCHE_PORT=7201
#KALLIP_ARION_INSTANCES_PORT=7301
# Dev tagma port override (arion dev compose only). Unset -> 3000 (the
# existing default). direnv sources .env into the shell, so arion eval sees it;
# the cron daemon (tagma-side companion) follows automatically.
#KALLIP_TAGMA_PORT=3000

# Stable archeion admin token (provisioning authority). If unset, the archeion
# generates a fresh sk-admin-... per boot and prints it to `arion logs archeion`.
# For arion dev, set the shared fixture so `kallip-admin` authenticates without
# grepping logs (see docs/development.md). The dev archeion-compose pins this
# fixture itself, because its enabled admin-login refuses tokens <32 chars.
# Prod must set a strong secret.
#KALLIP_ARCHEION_ADMIN_TOKEN=sk-admin-dev-0123456789abcdef0123456789abcdef

# The platform-internal secret is not set through .env: the archeion
# provisions it itself (generated into its state directory on first
# boot, then only read) and the other services receive the file path.
# See docs/reference/container.md for the deployment forms.
# OAuth sign-in providers (GitHub / Google). A provider's "Continue with X"
# button appears on the login + register pages only when BOTH its client id and
# secret are set (see archeion `configured()`). The archeion exchanges the
# authorization code server-side, so it must reach the provider's token endpoint
# over HTTPS (the dev container carries a CA bundle for this). Register the
# OAuth app at the provider with the callback URL
#   <KALLIP_ARCHEION_OAUTH_REDIRECT_BASE>/auth/callback
# -- the redirect base is the APP origin (the SPA owns the /auth/callback
# route that finishes the ceremony), NOT the archeion origin. Dev example:
# https://app.kallipai.lan/auth/callback  (app.<KALLIP_DOMAIN>). After
# setting these, restart the archeion (env_file is read at container start).
#KALLIP_ARCHEION_OAUTH_REDIRECT_BASE=https://app.kallipai.lan
#KALLIP_ARCHEION_OAUTH_GITHUB_CLIENT_ID=
#KALLIP_ARCHEION_OAUTH_GITHUB_CLIENT_SECRET=
#KALLIP_ARCHEION_OAUTH_GOOGLE_CLIENT_ID=
#KALLIP_ARCHEION_OAUTH_GOOGLE_CLIENT_SECRET=

# Tagma operator token. If unset, the tagma generates a random one at startup
# and prints it. Set explicitly for unattended/automated deploys.
#KALLIP_OPERATOR_TOKEN=

# The per-agent auth token the tagma injects into each agent's shell (so `kallip
# lesche send` and other self-scoped subcommands authenticate as that agent).
# For the operator-facing CLI, set this to KALLIP_OPERATOR_TOKEN. The
# kallip-cron daemon also reuses this for delivery (it must hold the tagma's
# operator secret so fired schedules inject as `[From: operator]`); the
# `kallip-cron` CLI reads it as the agent bearer for management requests.
#KALLIP_AUTH_TOKEN=

# Relay enrollment: a single-use sk-enroll-... minted via the archeion dashboard
# (after a user signs up). Set ONLY on the tagma's first boot (when
# KALLIP_POLIS_URL is set), then remove it -- the tagma token is
# then persisted under the instance data root's credentials/.
#KALLIP_TAGMA_RELAY_ENROLLMENT_CODE=

# --- prod-archeion only (dev derives these from KALLIP_DOMAIN, set to kallipai.lan by .env; do not set for dev)

# Postgres superuser credentials + db (read by BOTH postgres services,
# archeion-postgres and lesche-postgres). USER and DB default to "postgres" when
# unset, so set them to match BOTH *_DATABASE_URL below.
#POSTGRES_USER=kallip
#POSTGRES_PASSWORD=
#POSTGRES_DB=kallip
# Archeion DB url: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@archeion-postgres:5432/<POSTGRES_DB>
#KALLIP_ARCHEION_DATABASE_URL=
# WebAuthn RP: the registrable domain (cannot change without invalidating every
# passkey) and the exact origin the web app is served from. Defaults point at
# the prod pair (kallipai.com / https://app.kallipai.com); the dev compose
# already derives a working localhost RP pair for the http shape -- set all
# three explicitly only to override it, e.g. KALLIP_ARCHEION_WEBAUTHN_RP_ID=
# localhost, KALLIP_ARCHEION_WEBAUTHN_RP_ORIGIN=http://localhost:5173, and
# KALLIP_ARCHEION_WEBAUTHN_ALLOW_ANY_PORT=true (below).
#KALLIP_ARCHEION_WEBAUTHN_RP_ID=
#KALLIP_ARCHEION_WEBAUTHN_RP_ORIGIN=
# Allowed web-app origins; never a wildcard on a public deploy.
#KALLIP_ARCHEION_CORS_ORIGINS=
# Cookie Secure flag; keep true behind TLS (dev hardcodes true; it sits behind
# Caddy's TLS).
#KALLIP_ARCHEION_COOKIE_SECURE=true
# Session-cookie Domain. Set to the parent domain in a per-subdomain deploy so
# the session cookie is shared across app.<d> and api.<d> (e.g.
# kallipai.com). Unset (commented) = host-only, for a single-origin deploy. Dev
# uses kallipai.lan (set via KALLIP_DOMAIN in .env).
#KALLIP_ARCHEION_SESSION_COOKIE_DOMAIN=
# Trusted reverse-proxy CIDRs for X-Forwarded-For. The default trusts loopback
# only and is CLEARED on a public bind (the archeion warns) -- set this to the
# proxy's CIDR so per-client rate limiting works behind a remote TLS proxy.
#KALLIP_ARCHEION_TRUSTED_PROXIES=

# --- lesche (data-plane relay; separate process from the archeion)

# Archeion internal root for /internal/* ControlPlane calls (same host, different
# port in dev). The shared secret comes from the archeion block above.
#KALLIP_LESCHE_ARCHEION_INTERNAL_URL=http://127.0.0.1:7100
# Listen address (behind a TLS-terminating reverse proxy).
#KALLIP_LESCHE_ADDR=127.0.0.1:7200
# Allowed web-app origins; never a wildcard on a public deploy.
#KALLIP_LESCHE_CORS_ORIGINS=
# Postgres URL for the durable chat store (rooms, membership, message payloads):
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@lesche-postgres:5432/<POSTGRES_DB>.
#KALLIP_LESCHE_DATABASE_URL=

# --- files (content transfer; kallip-files)
#
# Archeion internal root for /internal/* ControlPlane calls (the private
# compose-network hop; never publicly routed). The shared secret is
# compose-network hop; never publicly routed). The shared secret is the
# archeion-provisioned internal token; its file path is deployment
# configuration (KALLIP_POLIS_INTERNAL_TOKEN_FILE), not a .env value.
#KALLIP_FILES_ARCHEION_INTERNAL_URL=http://127.0.0.1:7100
# Listen address (behind a TLS-terminating reverse proxy).
#KALLIP_FILES_ADDR=127.0.0.1:7400
# Postgres URL for the metadata store:
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@files-postgres:5432/<POSTGRES_DB>.
#KALLIP_FILES_DATABASE_URL=
# Root directory of the content-addressed blob store (backed by the
# kallipai_files_blobs named volume in compose; must match the volume mount target).
#KALLIP_FILES_BLOB_ROOT=/var/lib/kallipai/files/blobs
# --- prod-tagma only
# Multiple platform edges (multi-relay) tagmas: <data-root>/relays.toml ([[relay]]
# name / polis_url / enrollment_code; see docs/development.md) declares several
# edges at once; the KALLIP_POLIS_URL var below is the single-edge sugar (one
# implicit entry named "default"). The file and the var are mutually exclusive
# (fail-fast).

# The platform's public API origin: the single base from which the tagma
# derives every platform endpoint -- enrollment at the archeion, the lesche
# tunnel, envelopes, key-exchange responses, and media fetches (e.g.
# https://api.kallipai.com). Setting it (any non-empty value) activates the
# relay; if enrollment fails the tagma degrades to local-only (logs an error,
# keeps serving local agents; the lesche message route returns 503).
#KALLIP_POLIS_URL=


# Max `kallip lesche send` deliveries per burst window (bounds a runaway agent
# message loop; process-global — today one root agent = one conversation).
# Default: 20.
#KALLIP_TAGMA_RELAY_MESSAGE_BURST_MAX=20

# Length in seconds of the message burst window. Default: 10.
#KALLIP_TAGMA_RELAY_MESSAGE_BURST_WINDOW_SECS=10
